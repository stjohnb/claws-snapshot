{
  "name": "claws",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run build:client && tsc",
    "build:client": "node scripts/build-client.mjs",
    "build:css": "node scripts/build-tailwind.mjs",
    "dev": "tsx src/boot.ts",
    "start": "node dist/boot.js",
    "test": "vitest run",
    "test:pg": "CLAWS_TEST_PGLITE=1 vitest run src/db.test.ts src/worker.test.ts src/work-handlers.test.ts src/timeout-handler.test.ts src/config-store.test.ts src/config-watch.test.ts src/controller-client.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "baileys": "^7.0.0-rc14",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.16",
    "imapflow": "^2.10.2",
    "mailparser": "^3.14.2",
    "marked": "^18.1.3",
    "node-pty": "^1.1.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "undici": "^8.12.4",
    "ws": "^8.22.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@tailwindcss/cli": "^4.3.4",
    "@types/better-sqlite3": "^9",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "mermaid": "^12.3.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "node-pty": true,
    "esbuild": true,
    "@parcel/watcher": true,
    "protobufjs": true,
    "baileys": true
  }
}
