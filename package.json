{
  "name": "claws",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run build:client && tsc",
    "build:client": "node scripts/build-client.mjs",
    "build:css": "node scripts/build-tailwind.mjs",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:pg": "CLAWS_TEST_PGLITE=1 vitest run src/db.test.ts src/worker.test.ts src/work-handlers.test.ts src/timeout-handler.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "baileys": "^7.0.0-rc14",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.13",
    "imapflow": "^2.3.0",
    "mailparser": "^3.9.37",
    "marked": "^18.1.0",
    "node-pty": "^1.1.0",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "undici": "^8.11.2",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/cli": "^4.3.3",
    "@types/better-sqlite3": "^9",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "mermaid": "^12.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7",
    "vitest": "^5.0.3"
  }
}
