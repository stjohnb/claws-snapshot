{
  "name": "claws",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run build:client && tsc",
    "build:client": "node scripts/build-client.mjs",
    "build:css": "node scripts/build-tailwind.mjs",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:pg": "CLAWS_TEST_PGLITE=1 vitest run src/db.test.ts src/worker.test.ts src/work-handlers.test.ts src/timeout-handler.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "baileys": "^7.0.0-rc14",
    "better-sqlite3": "^13",
    "hono": "^4.13.3",
    "imapflow": "^1.7.8",
    "mailparser": "^3.9.24",
    "node-pty": "^1.0.0",
    "nodemailer": "^10.0.7",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "undici": "^8.10.2",
    "ws": "^8.21.3",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/cli": "^4.3.3",
    "@types/better-sqlite3": "^9",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8",
    "esbuild": "^0.28.2",
    "jsdom": "^30",
    "mermaid": "^11",
    "tailwindcss": "^4.3.2",
    "tsx": "^4",
    "typescript": "^7",
    "vitest": "^5.0.0"
  }
}
